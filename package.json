{
  "name": "@icedcola/dsh-provider-veark",
  "version": "0.1.11",
  "description": "火山方舟 Coding Plan LLM provider for DeepSeek Harness — 图片走 Ark Files API 优先（input_image + file_id），base64 data URL 自动兜底，Responses API 流式",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "DEV.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "volcengine",
    "ark",
    "coding-plan",
    "vision",
    "files-api"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "@deepseek-ai/dsh-client-runtime/client"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "dependencies": {
    "@volcengine/ark-runtime": "^1.0.10",
    "@deepseek-ai/schemastery": "^3.18.1",
    "eventsource-parser": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs test/client-card.test.mjs test/render.test.mjs test/render-smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IcedWatermelonJuice/dsh-provider-veark.git"
  }
}
